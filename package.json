{
  "name": "subsuku-yameta-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run price:check && vite build && node scripts/prerender.mjs",
    "build:nossg": "vite build",
    "lint": "eslint .",
    "price:watch": "node scripts/price-watch/price-watch.mjs",
    "price:reconcile": "node scripts/price-watch/reconcile.mjs",
    "price:check": "node scripts/price-watch/check-consistency.mjs && node scripts/price-watch/audit-prose-prices.mjs",
    "preview": "vite preview",
    "threads:post": "node scripts/threads/post.mjs",
    "threads:dry": "node scripts/threads/post.mjs --dry-run",
    "price:fetch": "node scripts/price-watch/fetch-pages.mjs",
    "price:audit-prose": "node scripts/price-watch/audit-prose-prices.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "simple-icons": "^16.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "puppeteer": "^25.1.0",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0"
  }
}
